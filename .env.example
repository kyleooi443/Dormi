# Public Supabase settings — embedded in the app bundle. Safe to expose because
# row level security enforces every permission. Used by the Expo app.
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Bootstrap script only (scripts/bootstrap.mjs) — server-side secrets.
# Never expose these to the app and never commit real values.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
UDH_ADMIN_PASSWORD=change-me-admin
UDH_TENANT_1_PASSWORD=change-me-1
UDH_TENANT_2_PASSWORD=change-me-2
UDH_TENANT_3_PASSWORD=change-me-3
UDH_TENANT_4_PASSWORD=change-me-4
UDH_TENANT_5_PASSWORD=change-me-5
UDH_TENANT_6_PASSWORD=change-me-6
UDH_TENANT_7_PASSWORD=change-me-7
