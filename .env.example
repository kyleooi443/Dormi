# Supabase project settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=replace-with-your-anon-key
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key

# Used only by the first admin bootstrap endpoint; keep this secret.
UDH_ADMIN_INVITE_CODE=replace-with-a-long-random-value

# One-time designated-account bootstrap secret and passwords.
UDH_BOOTSTRAP_CODE=replace-with-another-long-random-value
UDH_ADMIN_PASSWORD=replace-with-a-strong-password
UDH_TENANT_1_PASSWORD=replace-with-a-strong-password
UDH_TENANT_2_PASSWORD=replace-with-a-strong-password
UDH_TENANT_3_PASSWORD=replace-with-a-strong-password
UDH_TENANT_4_PASSWORD=replace-with-a-strong-password
UDH_TENANT_5_PASSWORD=replace-with-a-strong-password
UDH_TENANT_6_PASSWORD=replace-with-a-strong-password
UDH_TENANT_7_PASSWORD=replace-with-a-strong-password

# Public URL used by OAuth callbacks
APP_URL=http://localhost:3000
